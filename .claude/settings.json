{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "if command -v isekai >/dev/null 2>&1; then isekai hook claude-guard; fi",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "isekai brief --format md 2>/dev/null || true",
            "type": "command"
          }
        ]
      }
    ]
  }
}
